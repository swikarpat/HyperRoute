<file path="infrastructure/docker-compose.yml">
services:
  # 1. Distributed Cache & Token Bucket
  redis:
    image: redis:7-alpine
    container_name: hyperroute-redis
    ports:
      - "6379:6379"
    restart: unless-stopped

  hyperroute:
    build:
      context: ../gateway
    container_name: hyperroute-gateway
    ports:
      - "8080:8080"
    environment:
      SPRING_DATA_REDIS_HOST: redis
      OTEL_EXPORTER_OTLP_ENDPOINT: http://tempo:4317
      LOKI_URL: http://loki:3100/loki/api/v1/push
    depends_on:
      - redis
      - tempo
      - loki
    restart: unless-stopped

  # 2. Apache Kafka 3.7 KRaft Event Log
  kafka:
    image: apache/kafka:3.7.0
    container_name: hyperroute-kafka
    ports:
      - "9092:9092"
    environment:
      KAFKA_NODE_ID: 1
      KAFKA_PROCESS_ROLES: 'broker,controller'
      KAFKA_LISTENERS: 'PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093'
      KAFKA_ADVERTISED_LISTENERS: 'PLAINTEXT://localhost:9092'
      KAFKA_CONTROLLER_LISTENER_NAMES: 'CONTROLLER'
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: 'CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT'
      KAFKA_CONTROLLER_QUORUM_VOTERS: '1@localhost:9093'
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS: 0
    restart: unless-stopped

  # 3. Open-Source AWS Moto Server (Secrets Manager & S3)
  moto:
    image: motoserver/moto:latest
    container_name: hyperroute-moto
    ports:
      - "4566:4566"
    restart: unless-stopped

  # 4. Distributed Tracing Backend
  tempo:
    image: grafana/tempo:latest
    container_name: hyperroute-tempo
    command: ["-config.file=/etc/tempo/tempo.yaml"]
    volumes:
      - ./tempo.yaml:/etc/tempo/tempo.yaml:ro
      - tempo-data:/tmp/tempo
    ports:
      - "4317:4317"
      - "4318:4318"
      - "3200:3200"
    restart: unless-stopped

  loki:
    image: grafana/loki:latest
    container_name: hyperroute-loki
    command: ["-config.file=/etc/loki/loki.yaml"]
    volumes:
      - ./loki.yaml:/etc/loki/loki.yaml:ro
      - loki-data:/tmp/loki
    ports:
      - "3100:3100"
    restart: unless-stopped

  prometheus:
    image: prom/prometheus:latest
    container_name: hyperroute-prometheus
    command: ["--config.file=/etc/prometheus/prometheus.yaml"]
    volumes:
      - ./prometheus.yaml:/etc/prometheus/prometheus.yaml:ro
      - prometheus-data:/prometheus
    ports:
      - "9090:9090"
    depends_on:
      - hyperroute
    restart: unless-stopped

  grafana:
    image: grafana/grafana:latest
    container_name: hyperroute-grafana
    volumes:
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
      - grafana-data:/var/lib/grafana
    ports:
      - "3000:3000"
    depends_on:
      - prometheus
      - loki
      - tempo
    restart: unless-stopped

  # 5. OpenTelemetry Collector (W3C Trace Pipeline)
  otel-collector:
    image: otel/opentelemetry-collector-contrib:latest
    container_name: hyperroute-otel
    command: ["--config=/etc/otel-collector-config.yaml"]
    volumes:
      - ./otel-collector-config.yaml:/etc/otel-collector-config.yaml:ro
    depends_on:
      - tempo
    restart: unless-stopped

networks:
  default:
    name: hyperroute

volumes:
  tempo-data:
  loki-data:
  prometheus-data:
  grafana-data:
</file>

