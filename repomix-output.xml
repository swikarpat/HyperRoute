<file path="contracts/proto/hyperroute/v1/fsm_engine.proto">
syntax = "proto3";

package hyperroute.v1;

option java_multiple_files = true;
option java_package = "com.hyperroute.v1";
option java_outer_classname = "FsmEngineProto";

enum AgentState {
  AGENT_STATE_UNSPECIFIED = 0;
  AGENT_STATE_IDLE = 1;
  AGENT_STATE_INGESTING_ALERT = 2;
  AGENT_STATE_PARSING_EVIDENCE = 3;
  AGENT_STATE_EXTRACTING_ACCOUNTS = 4;
  AGENT_STATE_CORRELATING_HISTORY = 5;
  AGENT_STATE_EVALUATING_RISK = 6;
  AGENT_STATE_AWAITING_HUMAN_APPROVAL = 7;
  AGENT_STATE_EXECUTING_FREEZE = 8;
  AGENT_STATE_ISSUING_CLEARANCE = 9;
  AGENT_STATE_TERMINATED_FAILED = 10;
  AGENT_STATE_TERMINATED_COMPLETED = 11;
}

enum ViolationFlag {
  VIOLATION_FLAG_NONE = 0;
  VIOLATION_FLAG_PII_SSN = 1;
  VIOLATION_FLAG_PII_PAN = 2;
  VIOLATION_FLAG_PROMPT_INJECTION = 4;
  VIOLATION_FLAG_UNAUTHORIZED_TOOL = 8;
  VIOLATION_FLAG_LOOP_DETECTED = 16;
  VIOLATION_FLAG_TOKEN_BUDGET_EXCEEDED = 32;
}

message TraceContext {
  string trace_id = 1;
  string span_id = 2;
  uint32 trace_flags = 3;
  string trace_state = 4;
}

message StateTransitionRequest {
  string workflow_id = 1;
  string agent_id = 2;
  AgentState from_state = 3;
  AgentState to_state = 4;
  uint64 step_index = 5;
  bytes payload_hash = 6;
  TraceContext trace_context = 7;
  map<string, string> metadata = 8;
}

message StateTransitionResponse {
  bool is_allowed = 1;
  uint32 rejection_code = 2;
  string rejection_reason = 3;
  AgentState current_state = 4;
  uint64 step_latency_ns = 5;
  uint32 accumulated_violations = 6;
  TraceContext trace_context = 7;
}

message TokenInspectionChunk {
  string workflow_id = 1;
  uint64 sequence_number = 2;
  string token_text = 3;
  bool is_final_chunk = 4;
  TraceContext trace_context = 5;
}

message TokenInspectionResult {
  bool is_clean = 1;
  uint32 violation_mask = 2;
  string sanitized_text = 3;
  uint64 scan_duration_ns = 4;
}

message WorkflowSnapshot {
  string workflow_id = 1;
  string agent_id = 2;
  AgentState current_state = 3;
  uint64 total_steps = 4;
  repeated AgentState state_history = 5;
  uint64 memory_footprint_bytes = 6;
  bool is_locked = 7;
}

service FsmComplianceEngine {
  rpc ValidateTransition(StateTransitionRequest) returns (StateTransitionResponse);
  rpc InspectTokenStream(stream TokenInspectionChunk) returns (stream TokenInspectionResult);
  rpc RecoverWorkflow(StateTransitionRequest) returns (WorkflowSnapshot);
}
</file>

