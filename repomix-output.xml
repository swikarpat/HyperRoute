syntax = "proto3";

package hyperroute;

import "google/protobuf/timestamp.proto";

option go_package = "github.com/swikarpat/hyperroute-contracts/fsm";

enum FSMAction {
  FSM_ACTION_UNKNOWN = 0;
  CLEAR_TRANSACTION = 1;
  CLEAR_WITH_EXCEPTION = 2;
  ESCALATE_TO_HUMAN = 3;
  FREEZE_FUNDS_AND_ESCALATE = 4;
  TRIGGER_AUDIT_INVESTIGATE = 5;
  REJECT_TRANSACTION = 6;
}

message TransitionRequest {
  string trace_id = 1;
  string alert_id = 2;
  FSMAction proposed_action = 3;
  string findings = 4; 
}

message TransitionResponse {
  bool success = 1;
  int32 resulting_state = 2;
  string message = 3;
  string trace_id = 4;
  string audit_dossier_hash = 5; 
  google.protobuf.Timestamp commit_timestamp = 6;
}

service FSMService {
  rpc TransitionState (TransitionRequest) returns (TransitionResponse);
}
